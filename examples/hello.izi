// hello.izi — basic hello world example

fn greet(name: string) {
    print(name)
}

fn add(a: int, b: int) -> int {
    return a + b
}

fn factorial(n: int) -> int {
    if n <= 1 {
        return 1
    }
    return n * factorial(n - 1)
}

fn main() {
    print("Hello, izi!")

    let x: int = add(3, 4)
    print(x)

    let f: int = factorial(5)
    print(f)

    let i: int = 0
    while i < 3 {
        print(i)
        i = i + 1
    }
}
